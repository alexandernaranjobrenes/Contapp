# El .env de producción en Hostinger (docs/produccion.md). En el servidor:
#     cp .env.production.example .env
# y se completa todo lo que dice «CAMBIAR». El .env no se versiona: guardá una
# copia fuera del servidor (lleva todas las contraseñas).

APP_NAME=Pivox
APP_ENV=production
# Si llevás la base de desarrollo, la MISMA APP_KEY de desarrollo: con ella
# están cifradas las credenciales de Hacienda de cada compañía. Si la base es
# nueva, una clave nueva: php artisan key:generate --force (en el servidor,
# con este .env ya copiado).
APP_KEY=CAMBIAR
APP_DEBUG=false
APP_URL=https://pivoxcr.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Un archivo por día en storage/logs, los últimos 14.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# La base que se crea en hPanel → Bases de datos → MySQL. Hostinger les pone
# el usuario como prefijo (u123456789_pivox). Si phpMyAdmin dice que el
# servidor es MariaDB, DB_CONNECTION=mariadb.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# El sitio va solo por HTTPS: la cookie de la sesión, también.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# En Hostinger no puede quedar un worker corriendo: las colas las atiende el
# programador (el cron de schedule:run de hPanel, routes/console.php).
QUEUE_WORKERS_IN_SCHEDULER=true

CACHE_STORE=database

# El correo de Hostinger (hPanel → Correos): el buzón notificaciones@pivoxcr.com.
# Con 465, el esquema es smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=notificaciones@pivoxcr.com
MAIL_PASSWORD=CAMBIAR
MAIL_FROM_ADDRESS="notificaciones@pivoxcr.com"
MAIL_FROM_NAME="${APP_NAME}"

# Las imágenes (fotos, logos, blog) en Cloudflare R2. AWS_ENDPOINT es la API
# de la cuenta; AWS_URL, el dominio propio del bucket (no el r2.dev).
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=CAMBIAR
AWS_SECRET_ACCESS_KEY=CAMBIAR
AWS_DEFAULT_REGION=auto
AWS_BUCKET=CAMBIAR
AWS_ENDPOINT=https://CAMBIAR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=https://media.pivoxcr.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Conti. Sin key, Conti no aparece.
OPENAI_API_KEY=CAMBIAR
OPENAI_MODEL=gpt-4.1-mini
# En producción, vacía: el QR del escáner usa APP_URL.
IP_SCANNER=

# Tipo de cambio del BCCR. Sin token, se carga a mano.
BCCR_TOKEN=CAMBIAR

# Facturación electrónica: la cédula de quien provee Pivox (ProveedorSistemas).
# Las credenciales del ATV las carga el Superusuario de cada compañía.
HACIENDA_SYSTEM_PROVIDER_ID=CAMBIAR
HACIENDA_TIMEOUT=25
HACIENDA_CONNECT_TIMEOUT=10
HACIENDA_PUBLIC_API_ENABLED=true

# El sitio público (CLAUDE.md secc. 40-42).
SITE_CONTACT_EMAIL=servicioalcliente@pivoxcr.com
SITE_REQUESTS_EMAIL=servicios@ncodedigital.com
# Vacía si el dominio se verifica en Search Console con un registro DNS.
GOOGLE_SITE_VERIFICATION=

VITE_APP_NAME="${APP_NAME}"
