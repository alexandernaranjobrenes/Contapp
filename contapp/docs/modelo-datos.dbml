// CONTAPP — Modelo de datos propuesto
// Ver docs/propuesta-contapp.md para el razonamiento de cada dominio.
// Convención: toda tabla transaccional/de configuración lleva company_id
// (excepto las marcadas como globales) y aplica CompanyScope en Eloquent.

Project contapp {
  database_type: 'MySQL'
  note: 'ERP contable SaaS multi-empresa para Costa Rica'
}

//////////////////////////////////////////////////////////
// CORE: Tenancy, usuarios, roles, permisos
//////////////////////////////////////////////////////////

Table companies {
  id bigint [pk, increment]
  legal_name varchar
  trade_name varchar
  tax_id varchar [note: 'cédula jurídica']
  country_code varchar [default: 'CR']
  local_currency_id bigint [ref: > currencies.id]
  foreign_currency_id bigint [ref: > currencies.id]
  system_currency_id bigint [ref: > currencies.id]
  timezone varchar [default: 'America/Costa_Rica']
  logo_path varchar
  status varchar [default: 'active', note: 'active|suspended']
  created_at timestamp
  updated_at timestamp
}

Table account_mask_configs {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  segment_lengths json [note: 'ej [1,2,2,2,3] para x-xx-xx-xx-xxx']
}

Table users {
  id bigint [pk, increment]
  name varchar
  email varchar [unique]
  password varchar
  is_super_admin boolean [default: false, note: 'global, no editable por UI normal']
  default_company_id bigint [ref: > companies.id]
  status varchar [default: 'active']
  created_at timestamp
  updated_at timestamp
}

Table company_user {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  user_id bigint [ref: > users.id]
  is_default boolean [default: false]

  indexes {
    (company_id, user_id) [unique]
  }
}

Table roles {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id, note: 'null = rol de sistema global']
  name varchar
  type varchar [note: 'super_admin|admin|user']
  can_grant_permissions boolean [default: false, note: 'delega la facultad de otorgar derechos, nunca delete']
  created_at timestamp
}

Table user_roles {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  role_id bigint [ref: > roles.id]
  company_id bigint [ref: > companies.id]
}

Table modules {
  id bigint [pk, increment]
  code varchar [unique, note: 'ventas, bancos, cxc, contabilidad, planillas...']
  name varchar
}

Table module_permissions {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  module_id bigint [ref: > modules.id]
  subject_type varchar [note: 'user|role']
  subject_id bigint
  access_level varchar [note: 'read_write|read|none']
}

Table company_modules {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  module_id bigint [ref: > modules.id]
  enabled boolean [default: true]
  enabled_at timestamp
}

Table audit_logs {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  user_id bigint [ref: > users.id]
  action varchar [note: 'create|update|delete|void|permission_change|period_close...']
  auditable_type varchar
  auditable_id bigint
  old_values json
  new_values json
  ip_address varchar
  created_at timestamp
}

//////////////////////////////////////////////////////////
// MOTOR DE DOCUMENTOS
//////////////////////////////////////////////////////////

Table document_types {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar [note: '3 letras: FVE, NCC, DVC, NDC, TRB, CKB, DEB, ADD, ADC, ACC']
  name varchar
  origin_module varchar [note: 'ventas|compras|bancos|contable|cxc|cxp|activos_fijos']
  generates_journal boolean [default: true]
  requires_electronic_key boolean [default: false]
  bp_line_requirement varchar [default: 'none', note: 'none|due_date|application|either — qué exige en líneas con socio de negocio (ver PostJournalService::post(), docs/decisiones.md 2026-08-24)']
  is_opening_type boolean [default: false, note: 'true solo en el tipo reservado que el sistema crea de oficio para saldos iniciales (ver OpeningBalanceBulkImporter, docs/decisiones.md 2026-08-24) — nunca elegible en el asiento manual']
  is_reconciliation_type boolean [default: false, note: 'true solo en el tipo reservado (código ARR) para traspasos de reconciliación interna (ver AccountReconciliationController, docs/decisiones.md 2026-08-24) — nunca elegible en el asiento manual']
  is_closing_type boolean [default: false, note: 'true solo en el tipo reservado (código ACC) para el asiento de cierre anual (ver PeriodCloseService::closingDocumentType(), docs/decisiones.md 2026-08-27) — nunca elegible en el asiento manual, y LedgerService lo excluye del mayor de cuentas de resultados']
  default_debit_account_id bigint [ref: > chart_of_accounts.id]
  default_credit_account_id bigint [ref: > chart_of_accounts.id]
  numbering_mask varchar [default: '99999999']
  field_count int [default: 8]
  next_consecutive int [default: 1]
  range_from bigint
  range_to bigint
  consecutive_on_save boolean [default: false]
  allow_out_of_range_dates boolean [default: false]
  prevent_admins_out_of_range boolean [default: false]
  date_range_from date
  date_range_to date
  currency_mode varchar [note: 'local_fija|extranjera_fija|libre']
  allows_balance_increase boolean [default: false]
  reads_document_classifications boolean [default: false]
  status varchar [default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, code) [unique]
  }
}

Table document_type_printing {
  id bigint [pk, increment]
  document_type_id bigint [ref: > document_types.id]
  workstation varchar
  assigned_printer varchar
  print_on_save boolean [default: false]
  enable_direct_print boolean [default: false]
  confirm_on_reprint boolean [default: false]
  resume_lines_on_print boolean [default: false]
  print_format_file varchar
}

Table document_type_officers {
  id bigint [pk, increment]
  document_type_id bigint [ref: > document_types.id]
  officer_role varchar [note: 'elaborated_by|reviewed_by|approved_by']
  required boolean [default: false]
}

Table document_type_visible_columns {
  id bigint [pk, increment]
  document_type_id bigint [ref: > document_types.id]
  column_key varchar
  visible boolean [default: true]
  language varchar [default: 'es']
}

Table document_type_permissions {
  id bigint [pk, increment]
  document_type_id bigint [ref: > document_types.id]
  subject_type varchar [note: 'user|role']
  subject_id bigint
  scope varchar [note: 'individual|group']
  can_create boolean [default: false]
  can_modify boolean [default: false]
  can_delete boolean [default: false, note: 'UI lo respeta, pero borrado real de contabilizado solo lo fuerza el super admin desde código']
  can_void boolean [default: false]
  can_vary_consecutive boolean [default: false]
  can_backdate boolean [default: false]
  can_modify_integrated_documents boolean [default: false]
  can_create_out_of_range boolean [default: false]
  can_modify_document_dates boolean [default: false]
}

//////////////////////////////////////////////////////////
// CONTABILIDAD: catálogo, monedas, asientos, períodos
//////////////////////////////////////////////////////////

Table currencies {
  id bigint [pk, increment]
  code varchar [unique, note: 'ISO 4217: CRC, USD...']
  name varchar
  symbol varchar
  decimal_places int [default: 2]

  Note: 'Catálogo global, sin company_id ni columna "type". El rol de cada
  moneda (local/extranjera/sistema) lo define companies.local_currency_id /
  foreign_currency_id / system_currency_id, que pueden apuntar al mismo
  registro (ver docs/decisiones.md, 2026-08-05).'
}

Table exchange_rates {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  currency_id bigint [ref: > currencies.id]
  rate_date date
  rate_type varchar [note: 'buy|sell|reference']
  rate decimal
  source varchar [note: 'bccr_api|manual']
  is_locked boolean [default: false]
  created_by bigint [ref: > users.id]
  created_at timestamp

  indexes {
    (company_id, currency_id, rate_date, rate_type)
  }
}

Table chart_of_accounts {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar [note: 'x-xx-xx-xx-xxx']
  parent_id bigint [ref: > chart_of_accounts.id]
  level int
  description_es varchar
  description_en varchar
  account_type varchar [note: 'asset|liability|equity|income|expense']
  normal_balance varchar [note: 'debit|credit']
  currency_mode varchar [note: 'local|foreign|both']
  accepts_posting boolean [default: false, note: 'solo cuentas hoja reciben movimiento']
  is_financial_report boolean [default: true]
  section varchar
  list_order int
  tax_classification varchar [note: 'none|sales|purchases|iva_general|iva_devengado|iva_soportado']
  is_active boolean [default: true]

  indexes {
    (company_id, code) [unique]
  }
}

Table fiscal_years {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  year int
  status varchar [default: 'open', note: 'open|closed']
}

Table fiscal_periods {
  id bigint [pk, increment]
  fiscal_year_id bigint [ref: > fiscal_years.id]
  period_number int
  start_date date
  end_date date
  status varchar [default: 'open', note: 'open|blocked|closed']
}

Table cost_centers {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
  start_date date [note: 'vigente desde']
  end_date date [note: 'vigente hasta; null = sin fecha de fin']
  is_active boolean [default: true]

  indexes {
    (company_id, code) [unique]
  }

  Note: 'Catálogo plano (sin jerarquía desde 2026-08-25, ver docs/decisiones.md) —
  un centro de costo ya no recibe asignación directa por línea de asiento,
  recibe su porción vía el reparto por porcentaje de una cost_allocation_rule.'
}

Table cost_allocation_rules {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
  valid_from date
  valid_until date [note: 'null = sin vencimiento']
  is_active boolean [default: true]

  indexes {
    (company_id, code) [unique]
  }

  Note: '"Norma de reparto" (SAP B1): una línea de asiento de cuenta de
  costo/gasto (chart_of_accounts.requires_cost_center) elige UNA de estas en
  vez de un centro de costo directo. Al contabilizar, PostJournalService::post()
  reparte el monto de la línea entre los centros de costo de sus
  cost_allocation_rule_lines, proporcional al porcentaje de cada una (deben
  sumar exactamente 100%), generando una journal_details real por centro de
  costo — así el mayor auxiliar por centro de costo sigue leyendo
  journal_details.cost_center_id directo, sin cambios.'
}

Table cost_allocation_rule_lines {
  id bigint [pk, increment]
  cost_allocation_rule_id bigint [ref: > cost_allocation_rules.id]
  cost_center_id bigint [ref: > cost_centers.id, note: 'restrictOnDelete: no se puede borrar un centro que una norma todavía reparte']
  percentage decimal(5,2)
  position int [note: 'decide qué línea absorbe el remanente de redondeo al repartir']

  indexes {
    (cost_allocation_rule_id, cost_center_id) [unique]
  }
}

Table journal_entries {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  document_type_id bigint [ref: > document_types.id]
  document_number bigint
  document_date date [note: 'informativa: fecha del documento fuente, no fija período/TC/vigencias']
  posting_date date [note: 'rectora: fija período fiscal, tipo de cambio y vigencias de cuenta/tarifa']
  due_date date [note: 'opcional; precarga journal_details.due_date de cada línea al agregarla']
  fiscal_period_id bigint [ref: > fiscal_periods.id]
  description varchar
  status varchar [default: 'draft', note: 'draft|posted|voided']
  reversal_of_id bigint [ref: > journal_entries.id]
  schedule_id bigint [ref: > journal_entry_schedules.id, note: 'presente = este borrador lo generó una programación ("Programable"); ver journal_entry_schedules']
  source_module varchar
  business_partner_id bigint [ref: > business_partners.id]
  created_by bigint [ref: > users.id]
  posted_by bigint [ref: > users.id]
  posted_at timestamp
  created_at timestamp

  indexes {
    (company_id, document_type_id, document_number) [unique]
  }
}

Table journal_entry_schedules {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  document_type_id bigint [ref: > document_types.id]
  description varchar
  lines json [note: 'plantilla de líneas (cuenta, socio, moneda, débito/crédito, centro de costo, descripción) — subconjunto de JournalLineInput; sin clave electrónica/vencimiento/IVA/aplicación a partida, datos de un documento puntual, no de una receta que se repite']
  frequency_type varchar [note: 'days|months']
  interval_count int
  next_run_date date
  expires_at date [note: 'nullable = sin vencimiento']
  status varchar [default: 'active', note: 'active|expired|cancelled']
  created_by bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp

  note: 'Receta que JournalEntryScheduleService::processDue() usa para generar un
  journal_entries en estado draft (vía PostJournalService::saveDraft(), sin
  contabilizar nada solo) cada vez que next_run_date llega — avanza next_run_date
  (+interval_count días, o +interval_count meses con addMonthsNoOverflow para no
  "correrse" de fecha al cruzar febrero) y se marca expired sola si la próxima
  corrida ya pasa expires_at. Ver docs/decisiones.md 2026-08-24.'
}

Table journal_details {
  id bigint [pk, increment]
  journal_entry_id bigint [ref: > journal_entries.id]
  line_number int
  account_id bigint [ref: > chart_of_accounts.id]
  description varchar
  business_partner_id bigint [ref: > business_partners.id]
  cost_center_id bigint [ref: > cost_centers.id, note: 'centro específico de ESTA fila; si vino de una norma de reparto, una línea de entrada explota en varias filas, una por centro']
  cost_allocation_rule_id bigint [ref: > cost_allocation_rules.id, note: 'trazabilidad: qué norma generó esta fila, si aplica']
  currency_id bigint [ref: > currencies.id, note: 'moneda "natural" en que nació la línea']
  exchange_rate_lc_fc decimal
  exchange_rate_fc_sc decimal
  debit_local decimal
  credit_local decimal
  debit_foreign decimal
  credit_foreign decimal
  debit_system decimal
  credit_system decimal
  due_date date
  reference_document varchar
  bank_reconciled boolean [default: false]
}

//////////////////////////////////////////////////////////
// SOCIOS DE NEGOCIO / CxC-CxP
//////////////////////////////////////////////////////////

Table bp_categories {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
}

Table bp_families {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
}

Table business_partners {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar [note: 'alfanumérico x-xxx']
  name varchar
  type varchar [note: 'client|supplier|both']
  tax_id varchar
  email varchar
  economic_activity_code varchar [note: 'código de actividad económica de Hacienda, para facturación electrónica']
  phone varchar
  contact_name varchar [note: 'nombre del encargado']
  partner_since date [note: 'fecha de inicio como cliente/proveedor']
  category_id bigint [ref: > bp_categories.id]
  family_id bigint [ref: > bp_families.id]
  cost_center_id bigint [ref: > cost_centers.id, note: 'referencia informativa para reportes por centro de costo; no exige hoja ni vigencia']
  gl_account_id bigint [ref: > chart_of_accounts.id]
  currency_id bigint [ref: > currencies.id]
  credit_limit decimal
  payment_terms_days int
  status varchar [default: 'active']

  indexes {
    (company_id, code) [unique]
  }
}

Table bp_open_items {
  id bigint [pk, increment]
  business_partner_id bigint [ref: > business_partners.id]
  origin_journal_detail_id bigint [ref: > journal_details.id]
  document_type_code varchar
  document_number bigint
  due_date date
  original_amount decimal
  currency_id bigint [ref: > currencies.id]
  last_revaluation_rate decimal [note: 'TC de la última revaluación de cierre que incluyó esta partida (FxRevaluationService) — si está presente, ApplyPaymentService lo usa como base del diferencial REALIZADO en vez del TC original, para no contar dos veces la porción ya reconocida como no realizado (docs/decisiones.md 2026-08-24)']
  applied_amount decimal [default: 0]
  balance decimal
  status varchar [default: 'open', note: 'open|partial|closed']
}

Table bp_payment_applications {
  id bigint [pk, increment]
  payment_journal_entry_id bigint [ref: > journal_entries.id]
  open_item_id bigint [ref: > bp_open_items.id]
  applied_amount decimal
  applied_date date
  exchange_rate decimal
  realized_fx_difference decimal [default: 0]
  created_by bigint [ref: > users.id]
}

Table account_reconciliations {
  id bigint [pk, increment]
  account_id bigint [ref: > chart_of_accounts.id]
  reconciled_by bigint [ref: > users.id]
  reconciled_at timestamp
  created_at timestamp
  updated_at timestamp

  Note: 'Reconciliación interna genérica (docs/decisiones.md 2026-08-24):
  agrupa movimientos de UNA MISMA cuenta cuyo neto en moneda local es cero.
  Sin company_id propio (se filtra vía account_id -> chart_of_accounts.company_id).
  Deshacer = delete físico (cascada a account_reconciliation_lines); no toca
  ningún journal_detail. Excluye a propósito movimientos con
  business_partner_id — esos usan bp_open_items/bp_payment_applications.'
}

Table account_reconciliation_lines {
  id bigint [pk, increment]
  account_reconciliation_id bigint [ref: > account_reconciliations.id]
  journal_detail_id bigint [ref: > journal_details.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    journal_detail_id [unique, note: 'una línea solo puede estar en UNA reconciliación activa a la vez']
  }
}

//////////////////////////////////////////////////////////
// BANCOS
//////////////////////////////////////////////////////////

Table bank_accounts {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  gl_account_id bigint [ref: > chart_of_accounts.id]
  bank_name varchar
  account_number varchar
  currency_id bigint [ref: > currencies.id]
}

Table bank_reconciliations {
  id bigint [pk, increment]
  bank_account_id bigint [ref: > bank_accounts.id]
  cutoff_date date
  bank_balance decimal
  book_balance decimal
  unrecorded_deposits decimal [default: 0]
  unpaid_checks decimal [default: 0]
  unrecorded_bank_credits decimal [default: 0]
  unrecorded_bank_debits decimal [default: 0]
  status varchar [default: 'in_progress']
  created_by bigint [ref: > users.id]
}

Table bank_reconciliation_lines {
  id bigint [pk, increment]
  bank_reconciliation_id bigint [ref: > bank_reconciliations.id]
  journal_detail_id bigint [ref: > journal_details.id]
  matched_in_books boolean [default: false]
  matched_in_bank boolean [default: false]
  bank_statement_line_id bigint [ref: > bank_statement_lines.id]
}

Table bank_statement_lines {
  id bigint [pk, increment]
  bank_account_id bigint [ref: > bank_accounts.id]
  statement_date date
  description varchar
  amount decimal
  import_batch_id varchar
  matched boolean [default: false]
}

//////////////////////////////////////////////////////////
// IVA / FISCAL (Costa Rica)
//////////////////////////////////////////////////////////

Table tax_types {
  id bigint [pk, increment]
  code varchar [note: 'IVA, RENTA...']
  name varchar
}

Table tax_rates {
  id bigint [pk, increment]
  tax_type_id bigint [ref: > tax_types.id]
  code varchar
  name varchar
  percentage decimal
  grants_fiscal_credit boolean [default: false, note: 'si este indicador da derecho a crédito fiscal']
  fiscal_credit_note varchar [note: 'matiz libre, ej. "Tarifa reducida", "Salvo exportaciones/exoneraciones"']
  effective_from date
  effective_to date
}

Table journal_detail_taxes {
  id bigint [pk, increment]
  journal_detail_id bigint [ref: > journal_details.id]
  tax_rate_id bigint [ref: > tax_rates.id]
  taxable_base decimal
  tax_amount decimal
}

//////////////////////////////////////////////////////////
// DIFERENCIAL CAMBIARIO
//////////////////////////////////////////////////////////

Table fx_revaluation_runs {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  cutoff_date date
  exchange_rate_used decimal
  gain_account_id bigint [ref: > chart_of_accounts.id, note: 'contrapartida de ganancia cambiaria — separada de pérdida desde 2026-08-24, antes era una sola cuenta compartida']
  loss_account_id bigint [ref: > chart_of_accounts.id]
  document_type_id bigint [ref: > document_types.id]
  journal_entry_id bigint [ref: > journal_entries.id]
  status varchar [default: 'draft']
  executed_by bigint [ref: > users.id]
  executed_at timestamp
}

Table fx_revaluation_details {
  id bigint [pk, increment]
  fx_revaluation_run_id bigint [ref: > fx_revaluation_runs.id]
  account_id bigint [ref: > chart_of_accounts.id]
  business_partner_id bigint [ref: > business_partners.id]
  foreign_balance decimal
  historical_local_amount decimal
  revalued_local_amount decimal
  difference decimal
  journal_detail_id bigint [ref: > journal_details.id]
}

//////////////////////////////////////////////////////////
// CIERRES Y SALDOS INICIALES
//////////////////////////////////////////////////////////

Table period_closing_processes {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  fiscal_period_id bigint [ref: > fiscal_periods.id]
  type varchar [note: 'month_close|year_close|month_reopen']
  document_type_id bigint [ref: > document_types.id]
  journal_entry_id bigint [ref: > journal_entries.id]
  executed_by bigint [ref: > users.id]
  executed_at timestamp
  status varchar [default: 'completed']
}

Table opening_balances {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  fiscal_year_id bigint [ref: > fiscal_years.id]
  account_id bigint [ref: > chart_of_accounts.id]
  business_partner_id bigint [ref: > business_partners.id]
  debit_local decimal [default: 0]
  credit_local decimal [default: 0]
  debit_foreign decimal [default: 0]
  credit_foreign decimal [default: 0]
  currency_id bigint [ref: > currencies.id]
  imported_by bigint [ref: > users.id]
  imported_at timestamp
}

//////////////////////////////////////////////////////////
// INVENTARIO
// Diseño de Fase 0 (docs/decisiones.md 2026-09-13). Cubre Fases 1-2
// (catálogos + kardex + entrada/salida/ajuste). Landed costs, producción
// y ubicaciones WMS son fases posteriores y todavía no tienen tablas acá.
//////////////////////////////////////////////////////////

Table units_of_measure {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
  decimals tinyint [default: 2, note: 'decimales admitidos en cantidad; unidades indivisibles usan 0']
  status varchar [default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, code) [unique]
  }
}

Table item_groups {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
  status varchar [default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, code) [unique]
  }
}

Table warehouses {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
  address varchar
  is_default boolean [default: false]
  status varchar [default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, code) [unique]
  }
}

Table items {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar
  name varchar
  item_group_id bigint [ref: > item_groups.id]
  uom_id bigint [ref: > units_of_measure.id]
  barcode varchar
  is_inventory_item boolean [default: true, note: 'false = servicio: se compra/vende pero no lleva kardex ni costo']
  is_sales_item boolean [default: true]
  is_purchase_item boolean [default: true]
  tax_rate_id bigint [ref: > tax_rates.id, note: 'indicador de impuesto por defecto de la línea']
  avg_cost_local decimal(18,6) [default: 0, note: 'promedio ponderado móvil, GLOBAL por artículo (no por almacén)']
  avg_cost_foreign decimal(18,6) [default: 0, note: 'mismo promedio en FC; avg_cost_local/avg_cost_foreign es el TC congelado del stock']
  status varchar [default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, code) [unique]
    (company_id, item_group_id)
  }
}

// Única fuente de verdad de la existencia. La existencia total del artículo
// es un SUM sobre esta tabla y NO se almacena en items: el promedio móvil
// obliga a guardar el costo (es dependiente de la trayectoria), la cantidad no.
Table item_warehouses {
  id bigint [pk, increment]
  item_id bigint [ref: > items.id]
  warehouse_id bigint [ref: > warehouses.id]
  on_hand decimal(18,6) [default: 0]

  indexes {
    (item_id, warehouse_id) [unique]
  }
}

// Matriz de determinación de cuentas (G/L Account Determination de SAP B1).
// scope_id es polimórfico según scope_level — mismo patrón ya usado por
// document_type_permissions.subject_type/subject_id.
// Precedencia al resolver: item > item_group > warehouse > company, y si
// ninguna fila resuelve, cae a document_types.default_debit/credit_account_id.
Table gl_determinations {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  scope_level varchar [note: 'company|warehouse|item_group|item']
  scope_id bigint [note: 'null solo cuando scope_level=company']
  category varchar [note: 'inventory|gr_ir_clearing|cogs|stock_increase|stock_decrease|landed_cost_clearing|price_difference|wip|production_variance|write_down_allowance|write_down_expense']
  account_id bigint [ref: > chart_of_accounts.id]
  cost_allocation_rule_id bigint [ref: > cost_allocation_rules.id, note: 'obligatorio si la cuenta tiene requires_cost_center']
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, scope_level, scope_id, category) [unique]
  }
}

Table inventory_documents {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  document_type_id bigint [ref: > document_types.id]
  journal_entry_id bigint [ref: > journal_entries.id, note: 'null SOLO en un traslado cuyos almacenes comparten cuenta: no cambia el valor del inventario, así que no hay nada que contabilizar (decisiones 2026-09-15)']
  invoice_journal_entry_id bigint [ref: > journal_entries.id, note: 'asiento de la factura que liquidó la cuenta puente GR/IR; null = pendiente de facturar']
  operation varchar [note: 'goods_receipt|purchase_receipt|goods_issue|count_adjustment|production_issue|production_receipt|sales_issue|transfer']
  production_order_id bigint [ref: > production_orders.id, note: 'obligatorio en las dos operaciones de producción, null en el resto']
  document_date date
  posting_date date [note: 'fecha rectora, la misma del asiento']
  description varchar
  business_partner_id bigint [ref: > business_partners.id, note: 'proveedor; obligatorio en purchase_receipt, null en el resto']
  status varchar [default: 'posted', note: 'posted|voided — sin borrador, ver Fase 0']
  reversal_of_id bigint [ref: > inventory_documents.id]
  created_by bigint [ref: > users.id]
  posted_by bigint [ref: > users.id]
  posted_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, posting_date)
  }
}

Table inventory_document_lines {
  id bigint [pk, increment]
  inventory_document_id bigint [ref: > inventory_documents.id]
  line_number int
  item_id bigint [ref: > items.id]
  warehouse_id bigint [ref: > warehouses.id]
  warehouse_bin_id bigint [ref: > warehouse_bins.id, note: 'obligatoria si el almacén usa ubicaciones, null si no']
  to_warehouse_id bigint [ref: > warehouses.id, note: 'almacén de destino; solo en traslados']
  to_warehouse_bin_id bigint [ref: > warehouse_bins.id]
  quantity decimal(18,6) [note: 'siempre positiva; en un conteo es la cantidad CONTADA, no la diferencia']
  unit_cost_local decimal(18,6) [note: 'solo se digita en entradas; en salidas lo resuelve el promedio']
  unit_cost_foreign decimal(18,6)
  description varchar

  indexes {
    (inventory_document_id, line_number)
  }
}

// Costos de importación (flete, aranceles, seguro, agencia aduanal). Se
// capitalizan al costo del artículo solo en la proporción que sigue en
// existencia; el resto va a diferencia de precio (decisiones 2026-09-13 Fase 5).
Table landed_cost_documents {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  document_type_id bigint [ref: > document_types.id]
  journal_entry_id bigint [ref: > journal_entries.id]
  inventory_document_id bigint [ref: > inventory_documents.id, note: 'la recepción cuyo costo se incrementa']
  business_partner_id bigint [ref: > business_partners.id, note: 'quien cobra el flete/arancel']
  document_date date
  posting_date date
  amount decimal(18,2) [note: 'total a repartir, en moneda local']
  capitalized_amount decimal(18,2) [note: 'la parte que entró al inventario todavía en existencia']
  expensed_amount decimal(18,2) [note: 'la parte cuya mercancía ya salió']
  description varchar
  status varchar [default: 'posted', note: 'posted|voided']
  created_by bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, posting_date)
  }
}

// Guarda las cantidades con las que se calculó el reparto porque ambas cambian
// después: sin esa foto nadie puede reconstruir por qué se capitalizó esa
// proporción y no otra.
Table landed_cost_allocations {
  id bigint [pk, increment]
  landed_cost_document_id bigint [ref: > landed_cost_documents.id]
  item_id bigint [ref: > items.id]
  warehouse_id bigint [ref: > warehouses.id]
  received_quantity decimal(18,6)
  on_hand_quantity decimal(18,6) [note: 'existencia del artículo al momento de repartir']
  allocated_amount decimal(18,2)
  capitalized_amount decimal(18,2)
  expensed_amount decimal(18,2)
  created_at timestamp
  updated_at timestamp
}

// Orden de fabricación (Fase 6). Sin lista de materiales a propósito: el plan
// de componentes es conveniencia de catálogo, no un hecho contable — se emite
// lo que de verdad se consumió.
Table production_orders {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  item_id bigint [ref: > items.id, note: 'el producto a fabricar']
  warehouse_id bigint [ref: > warehouses.id, note: 'dónde ingresa el producto terminado']
  planned_quantity decimal(18,6)
  produced_quantity decimal(18,6) [default: 0]
  order_date date
  description varchar
  status varchar [default: 'open', note: 'open|closed']
  variance_journal_entry_id bigint [ref: > journal_entries.id, note: 'asiento que descargó el WIP sobrante al cerrar; null si cerró en cero']
  closed_at timestamp
  created_by bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, status)
  }
}

// Ubicaciones dentro de un almacén (Fase 7). Capa puramente LOGÍSTICA: el
// costo promedio sigue siendo global por artículo, así que una ubicación
// nunca cambia cuánto vale una unidad, solo dónde está.
Table warehouse_bins {
  id bigint [pk, increment]
  warehouse_id bigint [ref: > warehouses.id]
  code varchar
  name varchar
  status varchar [default: 'active', note: 'active|inactive']
  created_at timestamp
  updated_at timestamp

  indexes {
    (warehouse_id, code) [unique]
  }
}

// Desglosa —nunca reemplaza— a item_warehouses: la suma de las ubicaciones de
// un almacén es siempre igual a su on_hand.
Table item_bins {
  id bigint [pk, increment]
  item_id bigint [ref: > items.id]
  warehouse_bin_id bigint [ref: > warehouse_bins.id]
  on_hand decimal(18,6) [default: 0]
  created_at timestamp
  updated_at timestamp

  indexes {
    (item_id, warehouse_bin_id) [unique]
  }
}

// Kardex (OINM). Append-only: sin updated_at, nunca se edita ni se borra —
// una corrección es un documento de reversión que agrega filas nuevas.
// Una fila nace de un movimiento de stock o de una revaluación de valor
// (landed cost, diferencia de precio), y apunta a lo que la causó.
Table stock_journals {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  item_id bigint [ref: > items.id]
  warehouse_id bigint [ref: > warehouses.id]
  warehouse_bin_id bigint [ref: > warehouse_bins.id, note: 'null en almacenes sin ubicaciones']
  inventory_document_line_id bigint [ref: > inventory_document_lines.id, note: 'null en una revaluación por costo de importación']
  landed_cost_allocation_id bigint [ref: > landed_cost_allocations.id, note: 'solo en revaluaciones por costo de importación']
  journal_entry_id bigint [ref: > journal_entries.id]
  posting_date date
  direction varchar [note: 'in|out|revaluation — una revaluación no mueve unidades, solo valor']
  quantity decimal(18,6)
  unit_cost_local decimal(18,6)
  unit_cost_foreign decimal(18,6)
  total_cost_local decimal(18,2) [note: 'ya redondeado: es el monto exacto que fue al asiento']
  total_cost_foreign decimal(18,2)
  balance_quantity decimal(18,6) [note: 'existencia del almacén después de este movimiento — foto de auditoría, no fuente de verdad']
  avg_cost_local_after decimal(18,6) [note: 'promedio global del artículo después de este movimiento']
  avg_cost_foreign_after decimal(18,6)
  reversal_of_id bigint [ref: > stock_journals.id]
  created_by bigint [ref: > users.id]
  created_at timestamp

  indexes {
    (company_id, item_id, warehouse_id, posting_date)
    (journal_entry_id)
  }
}

//////////////////////////////////////////////////////////
// IA
//////////////////////////////////////////////////////////

Table ai_provider_settings {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  provider varchar [note: 'anthropic|openai']
  api_key_encrypted varchar
  model varchar
  enabled_features json
  monthly_token_budget int
}

Table ai_usage_logs {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  user_id bigint [ref: > users.id]
  feature varchar
  tokens_used int
  estimated_cost decimal
  created_at timestamp
}

//////////////////////////////////////////////////////////
// FACTURACIÓN ELECTRÓNICA (Hacienda v4.4)
// Los catálogos de la norma (tipos de comprobante, tarifas de IVA, medios de
// pago, unidades...) NO son tablas: viven en FiscalCatalogs porque son valores
// que fija la norma, no configuración del usuario.
//////////////////////////////////////////////////////////

// De cuál actividad se factura define a qué cuenta de ingresos va la venta.
Table company_economic_activities {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  code varchar [note: 'código de actividad económica de Hacienda, 6 dígitos']
  name varchar
  revenue_account_id bigint [ref: > chart_of_accounts.id]
  is_default boolean [default: false]
  status varchar [default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, code) [unique]
  }
}

// Puente entre la tarifa de la norma y lo que el ERP necesita: la cuenta del
// débito fiscal y el indicador de impuesto equivalente, que es lo que mantiene
// vivo el reporte de IVA ya existente.
Table billing_tax_accounts {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  iva_rate_code varchar [note: 'Nota 8.1']
  account_id bigint [ref: > chart_of_accounts.id]
  tax_rate_id bigint [ref: > tax_rates.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, iva_rate_code) [unique]
  }
}

// Contra qué cuenta se debita una venta de contado según cómo se cobró.
Table billing_payment_accounts {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  method_code varchar [note: 'Nota 6']
  account_id bigint [ref: > chart_of_accounts.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, method_code) [unique]
  }
}

// Los totales se ALMACENAN, a diferencia de casi todo el resto del sistema:
// no son un saldo derivable sino parte del documento firmado y enviado a
// Hacienda. Recalcularlos daría otro número si cambiara una tarifa o un precio.
Table sales_documents {
  id bigint [pk, increment]
  company_id bigint [ref: > companies.id]
  document_type_id bigint [ref: > document_types.id]
  fiscal_document_type varchar [note: 'Nota 3: 01 FE, 02 ND, 03 NC, 04 TE, 08 FEC, 09 FEE, 10 REP']
  situation varchar [default: '1', note: '1 normal, 2 contingencia, 3 sin internet']
  branch varchar [default: '001']
  terminal varchar [default: '00001']
  consecutive varchar [note: 'consecutivo fiscal de 20 dígitos']
  clave varchar [note: 'clave numérica de 50 dígitos']
  security_code varchar [note: 'dígitos 43-50 de la clave']
  emitter_activity_code varchar
  receiver_activity_code varchar
  business_partner_id bigint [ref: > business_partners.id, note: 'null solo en tiquete a consumidor final']
  currency_id bigint [ref: > currencies.id]
  exchange_rate decimal(18,5)
  sale_condition varchar [note: 'Nota 5']
  credit_term_days smallint [note: 'obligatorio en condiciones a crédito']
  document_date date
  posting_date date
  due_date date
  total_taxed_services decimal(18,5)
  total_exempt_services decimal(18,5)
  total_exonerated_services decimal(18,5)
  total_no_subject_services decimal(18,5)
  total_taxed_goods decimal(18,5)
  total_exempt_goods decimal(18,5)
  total_exonerated_goods decimal(18,5)
  total_no_subject_goods decimal(18,5)
  total_sale decimal(18,5)
  total_discounts decimal(18,5)
  total_net_sale decimal(18,5)
  total_tax decimal(18,5)
  total_document decimal(18,5)
  notes varchar
  status varchar [default: 'draft', note: 'draft|posted|voided']
  journal_entry_id bigint [ref: > journal_entries.id, note: 'asiento de la venta']
  inventory_document_id bigint [ref: > inventory_documents.id, note: 'salida con su costo de ventas; null si no mueve stock']
  created_by bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    (company_id, clave) [unique]
    (company_id, consecutive) [unique]
    (company_id, posting_date)
  }
}

// Los datos fiscales se copian del maestro al facturar y no se vuelven a leer
// de ahí: el comprobante debe poder reconstruirse tal cual se envió aunque el
// artículo cambie de CAByS o de descripción después.
Table sales_document_lines {
  id bigint [pk, increment]
  sales_document_id bigint [ref: > sales_documents.id]
  line_number int
  item_id bigint [ref: > items.id, note: 'null permite facturar un concepto libre']
  warehouse_id bigint [ref: > warehouses.id, note: 'null en servicios']
  warehouse_bin_id bigint [ref: > warehouse_bins.id]
  item_code varchar
  cabys_code varchar [note: '13 dígitos del BCCR']
  description varchar [note: 'entre 3 y 200 caracteres']
  unit_code varchar [note: 'Nota 15']
  is_service boolean [default: false, note: 'separa servicios de mercancías en el resumen']
  quantity decimal(16,3)
  unit_price decimal(18,5)
  total_amount decimal(18,5)
  discount_code varchar [note: 'Nota 20']
  discount_reason varchar [note: 'obligatorio si el código es 99']
  discount_amount decimal(18,5) [default: 0]
  subtotal decimal(18,5)
  tax_amount decimal(18,5) [default: 0]
  exonerated_amount decimal(18,5) [default: 0]
  line_total decimal(18,5)
  vin_or_serial varchar [note: 'obligatorio si el CAByS es vehículo, aeronave o embarcación']
  created_at timestamp
  updated_at timestamp

  indexes {
    (sales_document_id, line_number)
  }
}

// Una línea puede llevar varios impuestos y cada uno venir exonerado en parte.
Table sales_line_taxes {
  id bigint [pk, increment]
  sales_document_line_id bigint [ref: > sales_document_lines.id]
  tax_code varchar [note: 'Nota 8']
  iva_rate_code varchar [note: 'Nota 8.1']
  rate_percentage decimal(5,2)
  taxable_base decimal(18,5)
  amount decimal(18,5) [note: 'base × tarifa, antes de exoneración']
  exoneration_document_type varchar [note: 'Nota 10.1']
  exoneration_document_number varchar
  exoneration_article varchar
  exoneration_clause varchar
  exoneration_institution varchar [note: 'Nota 23']
  exoneration_date date
  exonerated_percentage decimal(5,2)
  exonerated_amount decimal(18,5) [default: 0]
  net_amount decimal(18,5) [note: 'lo que de verdad se cobra']
  created_at timestamp
  updated_at timestamp
}

// Hasta 4 por comprobante; su suma debe dar exactamente el total.
Table sales_payments {
  id bigint [pk, increment]
  sales_document_id bigint [ref: > sales_documents.id]
  method_code varchar [note: 'Nota 6']
  amount decimal(18,5)
  created_at timestamp
  updated_at timestamp
}

// Obligatorio en notas de crédito/débito y facturas de compra.
Table sales_references {
  id bigint [pk, increment]
  sales_document_id bigint [ref: > sales_documents.id]
  document_type varchar [note: 'Nota 10']
  number varchar [note: 'clave de 50 dígitos o número del documento físico']
  issued_at date
  reason_code varchar [note: 'Nota 9']
  reason varchar [note: 'entre 3 y 180 caracteres']
  created_at timestamp
  updated_at timestamp
}
